# Yosys Synthesis Script for SRMIC-X1 Sanity Check

# 1. Read RTL modules
read_verilog -sv rtl/ric.sv
read_verilog -sv rtl/hrm_region.sv
read_verilog -sv rtl/srmesh_router.sv
read_verilog -sv rtl/srmic_top.sv

# 2. Hierarchy Check
hierarchy -check -top srmic_top

# 3. Perform Synthesis
synth -top srmic_top

# 4. Resource Statistics
stat

# 5. Write Netlist
write_verilog build/srmic_synth.v
