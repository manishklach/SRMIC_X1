# Yosys Synthesis Script for SRMIC-X1 Sanity Check
# Runs from build/ directory via: cd build && yosys ../scripts/run_yosys.ys

# 1. Read RTL modules
read_verilog -sv -DSYNTHESIS ../rtl/ric.sv
read_verilog -sv -DSYNTHESIS ../rtl/hrm_region.sv
read_verilog -sv -DSYNTHESIS ../rtl/srmesh_router.sv
read_verilog -sv -DSYNTHESIS ../rtl/srmic_top.sv

# 2. Hierarchy Check
hierarchy -check -top srmic_top

# 3. Perform Synthesis
synth -top srmic_top

# 4. Resource Statistics
stat

# 5. Write Netlist
write_verilog srmic_synth.v